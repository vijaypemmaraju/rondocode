{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rondocode",
  "version": "0.1.0",
  "identifier": "com.rondocode.desktop",
  "build": {
    "frontendDist": "../../app/dist",
    "devUrl": "http://localhost:6060",
    "beforeDevCommand": "pnpm --filter @rondocode/app dev",
    "beforeBuildCommand": "pnpm --filter @rondocode/app build"
  },
  "app": {
    "windows": [
      {
        "title": "rondocode",
        "width": 1280,
        "height": 860,
        "minWidth": 480,
        "minHeight": 480,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": false,
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Music",
    "shortDescription": "Live-codeable synths and patterns",
    "longDescription": "rondocode on the desktop: local project files and a virtual MIDI port your DAW can record from.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "macOS": {
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "10.15",
      "files": {}
    }
  }
}
